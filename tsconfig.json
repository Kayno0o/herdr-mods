{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "moduleDetection": "force",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  // A mod's JS is checked by `herdr-app check` against the gpui-kit.d.ts Herdr writes beside it, whose globals clash with Bun's
  "exclude": ["node_modules", "mods/*/gpui-kit.d.ts"]
}
